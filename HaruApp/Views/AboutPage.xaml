<phone:PhoneApplicationPage
    x:Class="HaruApp.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:controls="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="480"
    d:DesignHeight="768"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait"
    Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    Style="{StaticResource TurnstilePageTransition}">

    <Grid Background="Transparent">
        <controls:Pivot Title="{Binding LocalizedResources.AppTitle, Source={StaticResource LocalizedStrings}}">
            <controls:PivotItem Header="{Binding LocalizedResources.PageAbout, Source={StaticResource LocalizedStrings}}">
                <Grid Margin="12,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <toolkit:HubTile Grid.Row="0"
                                     Grid.Column="0"
                                     Source="/Assets/ApplicationTile.png"
                                     Title="v2.0.0"
                                     Message="{Binding LocalizedResources.HaruMeaning, Source={StaticResource LocalizedStrings}}"/>

                    <StackPanel Grid.Row="0"
                                Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelTextStyle}"
                                   Text="{Binding LocalizedResources.LabelDevelopedBy, Source={StaticResource LocalizedStrings}}"/>
                        <TextBlock FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                   FontSize="{StaticResource PhoneFontSizeLarge}"
                                   Foreground="{StaticResource PhoneAccentBrush}"
                                   Text="FriendsNone"/>
                        <TextBlock FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                   FontSize="{StaticResource PhoneFontSizeSmall}"
                                   Foreground="{StaticResource PhoneForegroundBrush}"
                                   Text="@wizzardo.bsky.social"/>
                    </StackPanel>

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Text="{Binding LocalizedResources.MadeWithLove, Source={StaticResource LocalizedStrings}}"
                               Foreground="{StaticResource PhoneSubtleBrush}"
                               FontFamily="{StaticResource PhoneFontFamilyLight}"
                               FontSize="{StaticResource PhoneFontSizeSmall}"/>

                    <ScrollViewer Grid.Row="2"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Style="{StaticResource LabelTextStyle}"
                                           Text="{Binding LocalizedResources.LabelAppIcon, Source={StaticResource LocalizedStrings}}"/>
                                <TextBlock FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                           FontSize="{StaticResource PhoneFontSizeLarge}"
                                           Foreground="{StaticResource PhoneAccentBrush}"
                                           Text="Fluent UI System Icons"/>
                                <TextBlock FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                           FontSize="{StaticResource PhoneFontSizeSmall}"
                                           Foreground="{StaticResource PhoneForegroundBrush}"
                                           Text="Microsoft"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <TextBlock Style="{StaticResource LabelTextStyle}"
                                           Text="{Binding LocalizedResources.LabelWeatherIcons, Source={StaticResource LocalizedStrings}}"/>
                                <TextBlock FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                           FontSize="{StaticResource PhoneFontSizeLarge}"
                                           Foreground="{StaticResource PhoneAccentBrush}"
                                           Text="Meteocons"/>
                                <TextBlock FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                           FontSize="{StaticResource PhoneFontSizeSmall}"
                                           Foreground="{StaticResource PhoneForegroundBrush}"
                                           Text="Bas Milius"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4">
                                <TextBlock Style="{StaticResource LabelTextStyle}"
                                           Text="{Binding LocalizedResources.LabelWeatherApi, Source={StaticResource LocalizedStrings}}"/>
                                <TextBlock FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                           FontSize="{StaticResource PhoneFontSizeLarge}"
                                           Foreground="{StaticResource PhoneAccentBrush}"
                                           Text="Open-Meteo Weather API"/>
                                <TextBlock FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                           FontSize="{StaticResource PhoneFontSizeSmall}"
                                           Foreground="{StaticResource PhoneForegroundBrush}"
                                           Text="Open-Meteo.com"/>
                            </StackPanel>

                            <StackPanel Grid.Row="6">
                                <TextBlock Style="{StaticResource LabelTextStyle}"
                                           Text="{Binding LocalizedResources.LabelReverseGeocodingApi, Source={StaticResource LocalizedStrings}}"/>
                                <TextBlock FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                           FontSize="{StaticResource PhoneFontSizeLarge}"
                                           Foreground="{StaticResource PhoneAccentBrush}"
                                           Text="GeoNames"/>
                                <TextBlock FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                           FontSize="{StaticResource PhoneFontSizeSmall}"
                                           Foreground="{StaticResource PhoneForegroundBrush}"
                                           Text="GeoNames.org"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </controls:PivotItem>

            <controls:PivotItem Header="{Binding LocalizedResources.PivotChangelog, Source={StaticResource LocalizedStrings}}">
                <ScrollViewer Margin="12,0,12,0">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Foreground="{StaticResource PhoneAccentBrush}"
                                       FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                       FontSize="{StaticResource PhoneFontSizeLarge}"
                                       Text="[2.0.0] - 2026-10-16"/>
                            <TextBlock FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                       FontSize="{StaticResource PhoneFontSizeNormal}"
                                       Text="Added"/>
                            <StackPanel Margin="24,0,0,0">
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Favorites: save up to 6 places and switch between them"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Pin any favorite to Start as its own live tile"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Weather alerts when rain or storms start or stop, or the temperature changes sharply, for home or every favorite"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Use my location in search, with a privacy setting"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Wide live tiles and monochrome tile icons (Windows Phone 7.8+)"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Observation time on the back of the live tile"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Spanish translation"/>
                            </StackPanel>
                            <TextBlock Margin="0,12,0,0"
                                       FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                       FontSize="{StaticResource PhoneFontSizeNormal}"
                                       Text="Changed"/>
                            <StackPanel Margin="24,0,0,0">
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Search results use the phone's language"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Friendlier unit names in settings"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Daily dates are formatted for each language"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Forecasts older than 30 minutes refresh when you return to the app"/>
                            </StackPanel>
                            <TextBlock Margin="0,12,0,0"
                                       FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                       FontSize="{StaticResource PhoneFontSizeNormal}"
                                       Text="Fixed"/>
                            <StackPanel Margin="24,0,0,0">
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Temperatures are rounded instead of always rounded up"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; &quot;Forecast as of&quot; time no longer gets stuck"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Background updates keep running after a slow network request"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Missing forecast values show a dash instead of crashing the app"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; The background agents disabled message shows only once"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; The progress indicator no longer disappears too early"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Foreground="{StaticResource PhoneAccentBrush}"
                                       FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                       FontSize="{StaticResource PhoneFontSizeLarge}"
                                       Text="[1.0.0] - 2025-10-16"/>
                            <TextBlock FontFamily="{StaticResource PhoneFontFamilyNormal}"
                                       FontSize="{StaticResource PhoneFontSizeNormal}"
                                       Text="Added"/>
                            <StackPanel Margin="24,0,0,0">
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Current weather conditions with detailed metrics"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; 12-hour hourly forecast"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; 7-day daily forecast"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Global location search with geocoding"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Live tile with automatic background updates"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Offline support with smart caching"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Customizable weather units (temperature, wind speed, precipitation)"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Background tile updates toggle"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="&#8226; Day/night weather icon variants"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </controls:PivotItem>
        </controls:Pivot>
    </Grid>

</phone:PhoneApplicationPage>
